{
  "$schema": "node_modules/wrangler/config-schema.json",
  // notedrop is tailnet-only: the sender's identity is the tailnet user, so
  // there is no Cloudflare deployment. The base block stays Cloudflare-clean
  // by convention; everything real lives in env.procdev (bindings are not
  // inherited by wrangler environments, so they are repeated there).
  "name": "notedrop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/llms.txt"]
  },
  "vars": {
    "BASE_DOMAIN": "__BASE_DOMAIN__"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notedrop",
      "database_id": "__D1:notedrop__",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "env": {
    "procdev": {
      "name": "notedrop",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/llms.txt"]
      },
      "vars": {
        "BASE_DOMAIN": "__BASE_DOMAIN__"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "notedrop",
          "database_id": "__D1:notedrop__",
          "migrations_dir": "migrations"
        }
      ],
      // Note bodies live in D1: wrangler's R2 bucket check has no route on mf
      // and aborts the deploy, and D1 on mf is local SQLite anyway.
      "services": [{ "binding": "TAILNET", "service": "mf-tailnet" }]
    }
  }
}
